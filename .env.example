# Antigravity Homelab Universe Environment Variables

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the API_KEY GitHub secret used by the deploy workflow.
API_KEY=CHANGE_ME

# AI Vision Tagging
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Paths
# Use C:\path\to\nas for Windows testing, or /mnt/nas_data for Linux/Mac Mini
NAS_BASE_PATH=/mnt/nas_data

# Networking
KONG_GATEWAY_URL=http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO

# Local LLM Curation (Ollama)
USE_LOCAL_LLM=False
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b
